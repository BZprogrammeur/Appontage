<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="ocean_world">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins de base uniquement (ceux qui existent à coup sûr) -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.5 0.7 0.9 1</background>
      <sky></sky>
    </scene>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ocean">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
              <pbr>
                <metal>
                  <albedo_map>materials/textures/water_albedo.png</albedo_map>
                  <normal_map>materials/textures/water_normal.png</normal_map>
                  <roughness>0.1</roughness>
                  <metalness>0.2</metalness>
                </metal>
              </pbr>
            </material>
            <ambient>0.0 0.1 0.3 1</ambient>
            <diffuse>0.0 0.2 0.5 0.8</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
          <plugin filename="gz-sim-texture-video-system" name="gz::sim::systems::TextureVideo">
          </plugin>
        </visual>
      </link>
    </model>

    <!-- PLATEFORME pour avoir un point de repère -->
    <model name="platform">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>5 5 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
      <pose>0 0 0.25 0 0 0</pose>
    </model>
  </world>
</sdf>